# GO_ENV=production 部屬的時候要加
# 這是 Google Spreadsheet 的 ID（同一份試算表多個工作表）
GOOGLE_SHEET_ID=

# 方式 A：CSV 清單（向後相容）
# GOOGLE_SHEET_NAMES=秋葵,產銷絲瓜
# GOOGLE_SHEET_GIDS=12531213123,12312313

# 方式 B：動態多個工作表（依照環境變數數量自動抓取）
# GOOGLE_SHEET_1_GID=12531213123
# GOOGLE_SHEET_1_NAME=秋葵
# GOOGLE_SHEET_2_GID=12312313
# GOOGLE_SHEET_2_NAME=產銷絲瓜

GOOGLE_PLACES_API_KEY=

CORS_ORIGINS=*
API_PORT=8080
# CORS_ORIGINS=https://example.com, https://example2.com
API_URL=
RECENT_DAYS=3

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# 每日同步（只更新出貨資料）
DAILY_SYNC_HOUR=2
DAILY_SYNC_MINUTE=0

# 每月完整同步（包含 Places API）
MONTHLY_SYNC_DAY=1      # 每月1號
MONTHLY_SYNC_HOUR=3
MONTHLY_SYNC_MINUTE=0

# 同步 API 安全設定
ENABLE_SYNC_API=true
SYNC_SECRET=your-super-secret-key-here-change-me

# 清理超過 N 天的出貨資料（每日同步時會檢查）
SHIPMENT_RETENTION_DAYS=30